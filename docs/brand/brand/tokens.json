{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "brand": "gtmstack.ai",
    "version": "1.0.0",
    "updated": "2026-05",
    "author": "Matt Browning",
    "description": "GTM Stack design tokens — single source of truth for all brand outputs. Feeds Claude Design, Canva, Framer, and any downstream tool."
  },

  "color": {
    "lime": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "Electric Lime — primary accent. Owns all accent work across the system. One accent rule: never dilute with secondary colours."
    },
    "lime-dark": {
      "$value": "#2D4A00",
      "$type": "color",
      "$description": "Dark Lime — hover states and active backgrounds only."
    },
    "black": {
      "$value": "#0A0A0A",
      "$type": "color",
      "$description": "Primary background. Near-black, not pure black."
    },
    "ink": {
      "$value": "#141414",
      "$type": "color",
      "$description": "Secondary background — nav bars, elevated surfaces."
    },
    "zinc": {
      "$value": "#1E1E1E",
      "$type": "color",
      "$description": "Tertiary background — cards, modules, component backgrounds."
    },
    "grey": {
      "$value": "#333333",
      "$type": "color",
      "$description": "Borders and dividers."
    },
    "mid": {
      "$value": "#555555",
      "$type": "color",
      "$description": "De-emphasised elements — .ai domain suffix, secondary labels."
    },
    "muted": {
      "$value": "#888888",
      "$type": "color",
      "$description": "Supporting text, metadata, captions."
    },
    "white": {
      "$value": "#F5F5F5",
      "$type": "color",
      "$description": "Primary text on dark backgrounds. Off-white, not pure white."
    }
  },

  "typography": {
    "font-primary": {
      "$value": "IBM Plex Mono",
      "$type": "fontFamily",
      "$description": "Primary typeface. Used for all headlines, UI labels, code, and brand-critical text. Carries brand identity."
    },
    "font-body": {
      "$value": "Inter",
      "$type": "fontFamily",
      "$description": "Body typeface. Used for long-form reading and captions only. Two typefaces — never three."
    },
    "font-weight-regular": {
      "$value": "400",
      "$type": "fontWeight"
    },
    "font-weight-medium": {
      "$value": "500",
      "$type": "fontWeight"
    },
    "font-weight-semibold": {
      "$value": "600",
      "$type": "fontWeight"
    },
    "font-weight-bold": {
      "$value": "700",
      "$type": "fontWeight"
    },
    "size-xs": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Labels, metadata, badges."
    },
    "size-sm": {
      "$value": "10px",
      "$type": "dimension",
      "$description": "Component text, captions."
    },
    "size-base": {
      "$value": "13px",
      "$type": "dimension",
      "$description": "UI text, nav items."
    },
    "size-md": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Lockup text, subheadings."
    },
    "size-lg": {
      "$value": "22px",
      "$type": "dimension",
      "$description": "Section headings."
    },
    "size-xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Primary wordmark, hero headings."
    },
    "size-display": {
      "$value": "44px",
      "$type": "dimension",
      "$description": "Display/hero at maximum size."
    },
    "letter-spacing-tight": {
      "$value": "-0.5px",
      "$type": "dimension",
      "$description": "Large wordmark and headline tracking."
    },
    "letter-spacing-wide": {
      "$value": "0.18em",
      "$type": "dimension",
      "$description": "Label and metadata tracking."
    },
    "line-height-tight": {
      "$value": "1",
      "$type": "number",
      "$description": "Logo and display text."
    },
    "line-height-base": {
      "$value": "1.6",
      "$type": "number",
      "$description": "Body and UI text."
    }
  },

  "logo": {
    "prompt-mark": {
      "$value": ">_",
      "$type": "string",
      "$description": "The core brand mark. Always in Electric Lime (#A6FF00). Never replaced or recoloured."
    },
    "wordmark-gtm": {
      "$value": "#F5F5F5",
      "$type": "color",
      "$description": "Colour of 'gtm' in the wordmark."
    },
    "wordmark-stack": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "Colour of 'stack' in the wordmark. The product concept gets the accent."
    },
    "wordmark-tld": {
      "$value": "#555555",
      "$type": "color",
      "$description": "Colour of '.ai' in the wordmark. De-emphasised — it's an address, not the brand."
    },
    "pipe-divider": {
      "$value": "#333333",
      "$type": "color",
      "$description": "Vertical pipe separator used in lockup variants."
    }
  },

  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "20px", "$type": "dimension" },
    "xl": { "$value": "28px", "$type": "dimension" },
    "2xl": { "$value": "40px", "$type": "dimension" }
  },

  "border": {
    "width-default": { "$value": "1px", "$type": "dimension" },
    "color-default": { "$value": "#333333", "$type": "color" },
    "color-active": { "$value": "#A6FF00", "$type": "color" },
    "radius-sm": { "$value": "4px", "$type": "dimension", "$description": "Used sparingly — brand aesthetic is sharp, not rounded." },
    "radius-md": { "$value": "6px", "$type": "dimension", "$description": "Terminal chrome/icon only." }
  },

  "component": {
    "cta-background": { "$value": "#A6FF00", "$type": "color" },
    "cta-text": { "$value": "#0A0A0A", "$type": "color" },
    "cta-label": { "$value": ">_ Execute", "$type": "string", "$description": "Primary CTA pattern. Always prefixed with >_" },
    "badge-risk-background": { "$value": "#2A1A00", "$type": "color" },
    "badge-risk-text": { "$value": "#FFB020", "$type": "color" },
    "badge-risk-border": { "$value": "#3A2A00", "$type": "color" },
    "badge-marketing-background": { "$value": "#2D4A00", "$type": "color" },
    "badge-marketing-text": { "$value": "#A6FF00", "$type": "color" },
    "badge-shared-background": { "$value": "#1A2A4A", "$type": "color" },
    "badge-shared-text": { "$value": "#4A90D9", "$type": "color" }
  },

  "markdown": {
    "hash-colour": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "# heading prefixes rendered in lime. Core to the markdown-native visual language."
    },
    "list-marker-colour": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "- list item markers in lime."
    },
    "quote-border-colour": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "Left border on > blockquotes."
    },
    "code-text-colour": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "Inline and block code rendered in lime."
    },
    "table-value-colour": {
      "$value": "#A6FF00",
      "$type": "color",
      "$description": "Key metric values in tables rendered in lime."
    }
  },

  "css-variables": {
    "$description": "Drop-in CSS custom properties for the gtmstack.ai site. Import directly into Framer or any CSS file.",
    "$value": ":root { --lime: #A6FF00; --lime-dk: #2D4A00; --black: #0A0A0A; --ink: #141414; --zinc: #1E1E1E; --grey: #333333; --mid: #555555; --muted: #888888; --white: #F5F5F5; --mono: 'IBM Plex Mono', monospace; --sans: 'Inter', sans-serif; }"
  }
}
